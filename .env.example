# ==============================================================================
# APNA CLINIC — ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# Application Environment
APP_ENV=development
APP_NAME="Apna Clinic"

# Local Web Dev URL (Ensure this matches your Flutter web run port, e.g. --web-port=8080)
APP_BASE_URL=http://localhost:8080

# Set to false to test with real data instead of synthetic demo records
DEMO_DATA=false

# Set to false so the app uses real Firebase & Google OAuth instead of mock services
USE_MOCK_AUTH=false

ACCOUNT_REGISTRATION_URL=https://apnaclinic.in/register

# ------------------------------------------------------------------------------
# LAYER 1 & 2: FIREBASE CONFIGURATION (Clinic Account Login & Subscription)
# ------------------------------------------------------------------------------
# Get this from Firebase Console -> Project Settings -> General -> Your Apps (Web)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=apna-clinic-96541.firebaseapp.com
FIREBASE_PROJECT_ID=apna-clinic-96541
FIREBASE_STORAGE_BUCKET=apna-clinic-96541.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=543911993529
FIREBASE_APP_ID=1:543911993529:web:aee5950d6f96b28f1c3b68

# ------------------------------------------------------------------------------
# LAYER 3: GOOGLE CLOUD OAUTH (Google Drive & Google Sheets Sync)
# ------------------------------------------------------------------------------
# Get this from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
# Must have Authorized JavaScript origins: http://localhost:8080
# Must have Authorized redirect URIs: http://localhost:8080
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# LAYER 4: MONTHLY GOOGLE SHEETS STORAGE & APPS SCRIPT (Feature PRD/TRD v1.1)
# ------------------------------------------------------------------------------
# Enable monthly partitioning of transaction workbooks (Appointments, Visits, Invoices, Payments)
ENABLE_MONTHLY_STORAGE=false
# Deployed Google Apps Script Web App URL for monthly routing (optional; uses direct client if empty)
APPS_SCRIPT_WEB_APP_URL=

